# Copy to .env.local for local testing. On Vercel, add these under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Server only. Never share or put in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud → APIs & Services → Credentials
# Browser key (restrict to your Vercel domain): Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional Map ID for styled maps; DEMO_MAP_ID works for testing
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
# Server key (no referrer restriction; restrict by API): Routes API + Geocoding API
GOOGLE_MAPS_SERVER_KEY=

# Drivers sign in with a username. Behind the scenes it becomes username@this-domain.
# No email is ever sent there. Change only before creating drivers.
NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=drivers.cbasroutes.app

# The app name shown on phones and in the header. Change any time, then redeploy.
NEXT_PUBLIC_APP_NAME=CBAS Drivers
